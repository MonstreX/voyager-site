{
    "name": "monstrex/voyager-site",
    "description": "Voyager Site package",
    "license": "MIT",
    "authors": [
        {
            "name": "Yuriy Ovdeyev",
            "email": "fido6080net@gmail.com",
            "homepage": "http://ss-host.ru"
        }
    ],
    "minimum-stability": "stable",
    "homepage": "https://github.com/monstrex/voyager-site",
    "keywords": ["Laravel", "Voyager"],
    "require": {
        "monstrex/voyager": "^1.8",
        "liquid/liquid": "^1.4.44",
        "webwizo/laravel-shortcodes": "^1.0.27",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "~10.0|~11.0",
        "laravel/framework": "~11.0|~12.0"
    },
    "autoload": {
        "psr-4": {
            "MonstreX\\VoyagerSite\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MonstreX\\VoyagerSite\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MonstreX\\VoyagerSite\\VoyagerSiteServiceProvider"
            ]
        }
    }
}
